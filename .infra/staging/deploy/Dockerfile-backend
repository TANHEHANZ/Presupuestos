# Imagen base
FROM node:22-alpine

ENV TZ=America/La_Paz
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /code/backend

COPY ./backend/package*.json ./
RUN npm install

COPY ./backend/ ./

RUN npx prisma generate
RUN npm run build

COPY ./backend/.env.docker .env
